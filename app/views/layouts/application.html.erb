<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} · Safe Space Malaysia" : "Safe Space Malaysia" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Information on domestic and gender-based violence in Malaysia: what it is, the law, who can help, and hotlines.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application" %>
</head>
<body>
  <a class="quick-exit" href="https://www.google.com.my" rel="noopener"
     onclick="window.location.replace('https://www.google.com.my'); return false;">Quick Exit ✕</a>

  <!-- Live date & time (updated by site.js) -->
  <div class="topbar text-center small py-2"><span id="clock">Loading time…</span></div>

  <header class="masthead text-center">
    <div class="container">
      <p class="kicker mb-1">Malaysia · Awareness &amp; Support</p>
      <%= link_to "Safe Space", root_path, class: "brand" %>

      <nav class="navbar navbar-expand-lg justify-content-center mt-3">
        <button class="navbar-toggler mx-auto" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-center" id="mainNav">
          <ul class="navbar-nav gap-lg-3">
            <%= nav_link "What Is", what_is_path %>
            <%= nav_link "Law Enforcement", law_enforcement_path %>
            <%= nav_link "Enforcer", enforcer_path %>
            <%= nav_link "Hotline", hotline_path %>
            <%= nav_link "Safety Check", safety_check_path %>
            <%= nav_link "Contact", contact_path %>
          </ul>
        </div>
      </nav>
    </div>
  </header>

  <main class="container py-5"><%= yield %></main>

  <footer class="footer text-center py-4">
    <div class="container">
      <p class="mb-1"><strong>In immediate danger? Call 999.</strong></p>
      <p class="small opacity-75 mb-1">This website is for information only and is not legal advice. Numbers and procedures can change, so please confirm with the organisation concerned.</p>
      <p class="small opacity-75 mb-0">
        &copy;
        <!-- document.write() output #1: runs while the page is loading -->
        <script>document.write(new Date().getFullYear());</script>
        Safe Space Malaysia · Student project
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <%= javascript_include_tag "site" %>
  <%= yield :scripts %>
</body>
</html>
