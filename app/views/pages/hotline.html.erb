<% content_for :title, "Hotline" %>
<article class="col-lg-8 mx-auto">
  <p class="kicker">Reach out</p>
  <h1>Hotlines</h1>
  <p class="lead">Confidential support from trained people. If you cannot speak safely, try messaging instead.</p>

  <div class="card hot urgent mb-4 shadow-sm">
    <div class="card-body p-4">
      <span class="label">Emergency</span>
      <a class="num" href="tel:999">999</a>
      <p class="mb-0 text-muted">Police, ambulance and fire.</p>
    </div>
  </div>
  <div class="card hot mb-4 shadow-sm">
    <div class="card-body p-4">
      <span class="label">Talian Kasih (JKM)</span>
      <a class="num" href="tel:15999">15999</a>
      <p class="mb-0 text-muted">National helpline for welfare and abuse reports. WhatsApp: <a href="https://wa.me/60192615999">019-261 5999</a></p>
    </div>
  </div>
  <div class="card hot mb-4 shadow-sm">
    <div class="card-body p-4">
      <span class="label">Women's Aid Organisation (WAO)</span>
      <a class="num" href="tel:+60330008858">03-3000 8858</a>
      <p class="mb-0 text-muted">WhatsApp / SMS: <a href="https://wa.me/60189888058">018-988 8058</a></p>
    </div>
  </div>
  <div class="card hot mb-4 shadow-sm">
    <div class="card-body p-4">
      <span class="label">AWAM Telenita</span>
      <a class="num" href="tel:+60379561214">03-7956 1214</a>
      <p class="mb-0 text-muted">Counselling and information for women.</p>
    </div>
  </div>
  <div class="alert alert-sage">Please confirm each number and its operating hours before relying on them.</div>
</article>