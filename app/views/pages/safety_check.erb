<% content_for :title, "Safety Check" %>
<% content_for :scripts do %>
  <%= javascript_include_tag "safety_check" %>
<% end %>

<article class="col-lg-9 mx-auto">
  <p class="kicker">Self-check</p>
  <h1>Relationship safety check</h1>
  <p class="lead">Answer a few questions to learn about warning signs of abuse and where to find help. Everything is processed in your browser. <strong>Nothing is sent or stored.</strong></p>

  <div id="formErrors" aria-live="polite"></div>

  <!-- HTML FORM -->
  <form id="checkForm" class="card border-0 shadow-sm p-4 mb-4" novalidate>
    <div class="row g-3">
      <div class="col-md-6">
        <label for="nickname" class="form-label">Nickname <span class="text-muted">(optional)</span></label>
        <input type="text" class="form-control" id="nickname" name="nickname" maxlength="30" placeholder="e.g. Aina" autocomplete="off">
      </div>
      <div class="col-md-6">
        <label for="role" class="form-label">I am answering for</label>
        <select class="form-select" id="role" name="role" required>
          <option value="">Choose…</option>
          <option value="myself">Myself</option>
          <option value="friend">A friend</option>
          <option value="family">A family member</option>
        </select>
      </div>
      <div class="col-md-6">
        <label for="checkDate" class="form-label">Today's date</label>
        <input type="date" class="form-control" id="checkDate" name="checkDate" readonly>
      </div>
      <div class="col-md-6">
        <label for="lastIncident" class="form-label">Date of the most recent incident <span class="text-muted">(optional)</span></label>
        <input type="date" class="form-control" id="lastIncident" name="lastIncident">
      </div>
    </div>

    <fieldset class="mt-4">
      <legend class="h5 font-serif">Tick everything that applies</legend>
      <% signs = [
        ["Checks my phone or tracks where I go", 1],
        ["Controls my money or stops me from working", 1],
        ["Cuts me off from family and friends", 1],
        ["Insults or humiliates me", 2],
        ["Makes me afraid of how they will react", 2],
        ["Threatens to hurt me, my children or themselves", 3],
        ["Forces sexual acts I do not want", 3],
        ["Hits, pushes or physically hurts me", 3]
      ] %>
      <% signs.each_with_index do |(label, weight), i| %>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" name="signs" id="sign<%= i %>" value="<%= weight %>" data-label="<%= label %>">
          <label class="form-check-label" for="sign<%= i %>"><%= label %></label>
        </div>
      <% end %>
    </fieldset>

    <div class="mt-3">
      <label for="notes" class="form-label">Anything else you want to note <span class="text-muted">(optional, not saved)</span></label>
      <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="300"></textarea>
    </div>

    <div class="form-check mt-3">
      <input class="form-check-input" type="checkbox" id="understand" name="understand" required>
      <label class="form-check-label" for="understand">I understand this is not a diagnosis or legal advice.</label>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-rose rounded-pill px-4">See my result</button>
      <button type="reset" class="btn btn-outline-rose rounded-pill px-4">Clear</button>
    </div>
  </form>

  <!-- Output method 1: innerHTML target -->
  <div id="result" aria-live="polite"></div>
</article>

<!-- POP-UP DIALOG (Bootstrap modal) -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h4" id="helpTitle">Help is available</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="helpBody"></div>
      <div class="modal-footer">
        <a href="/hotline" class="btn btn-rose rounded-pill">All hotlines</a>
        <button type="button" class="btn btn-outline-rose rounded-pill" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
